build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# ------------------- Node / Frontend -------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
*.local

# ------------------- Database -------------------
*.db
*.sqlite
*.sqlite3

# PostgreSQL data
postgres_data/

# ------------------- Docker -------------------
.dockerignore

# ------------------- ML / AI -------------------
# Model caches
.cache/
*.pt
*.pth
*.onnx
models/
checkpoints/

# HuggingFace cache
.cache/huggingface/
huggingface/

# ------------------- OS -------------------
.DS_Store
Thumbs.db

# ------------------- Logs -------------------
*.log
logs/
*.out

