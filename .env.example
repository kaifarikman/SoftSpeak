# ===========================================
# SoftSpeak Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и измените значения по необходимости:
# cp .env.example .env

# ===========================================
# РЕЖИМ РАБОТЫ
# ===========================================
# true = MailHog (разработка), false = реальная почта (продакшен)
DEV_MODE=false

# ===========================================
# БАЗА ДАННЫХ
# ===========================================
POSTGRES_USER=softspeak_user
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=softspeak_db
POSTGRES_PORT=5432

# ===========================================
# BACKEND API
# ===========================================
BACKEND_PORT=8000
APP_BASE_URL=http://localhost:8000

# ===========================================
# JWT АУТЕНТИФИКАЦИЯ
# ===========================================
# Минимум 32 символа! Сгенерируй: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TTL_MIN=30

# ===========================================
# ПОЧТА / SMTP
# ===========================================
# Поддерживаются только: Yandex, Mail.ru, Gmail
# 
# ВАЖНО: Используйте ПАРОЛЬ ПРИЛОЖЕНИЯ, не основной пароль!
# 
# Для Yandex:
#   1. Включите IMAP/SMTP в настройках почты
#   2. Создайте пароль приложения: https://id.yandex.ru/security
#   3. Используйте порт 465 (SSL)
#
# Для Mail.ru:
#   1. Создайте пароль приложения в настройках безопасности
#   2. Используйте порт 465 (SSL)
#
# Для Gmail:
#   1. Включите 2FA в аккаунте Google
#   2. Создайте пароль приложения: https://myaccount.google.com/apppasswords
#   3. Используйте порт 587 (STARTTLS)

# Yandex (рекомендуется)
EMAIL_FROM=softspeak.noreply@yandex.ru
SMTP_USER=softspeak.noreply@yandex.ru
SMTP_PASSWORD=your_yandex_app_password_here

# Mail.ru (альтернатива - раскомментируй если используешь)
# EMAIL_FROM=softspeak@mail.ru
# SMTP_USER=softspeak@mail.ru
# SMTP_PASSWORD=your_mailru_app_password_here

# Gmail (альтернатива - раскомментируй если используешь)
# EMAIL_FROM=softspeak.app@gmail.com
# SMTP_USER=softspeak.app@gmail.com
# SMTP_PASSWORD=your_gmail_app_password_here

# Эти переменные будут автоматически переопределены на основе EMAIL_FROM
# Для Yandex/Mail.ru: SMTP_HOST=smtp.yandex.ru или smtp.mail.ru, порт 465, SSL
# Для Gmail: SMTP_HOST=smtp.gmail.com, порт 587, STARTTLS
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_TLS=false

# MailHog (только для разработки, когда DEV_MODE=true)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ===========================================
# ВЕРИФИКАЦИЯ EMAIL
# ===========================================
VERIFICATION_CODE_TTL_MIN=10
VERIFICATION_CODE_LENGTH=6
RATE_LIMIT_EMAIL_PER_HOUR=5

# ===========================================
# ML SERVICE
# ===========================================
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://ml-service:8001
ML_MODEL_NAME=intfloat/multilingual-e5-base

# ===========================================
# FRONTEND
# ===========================================
FRONTEND_PORT=3000

# ===========================================
# МАТЧИНГ
# ===========================================
MATCH_SIMILARITY_THRESHOLD=0.65

# ===========================================
# АДМИНКА
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_TOKEN=your_admin_token_secret_change_in_production

# ===========================================
# ПРИМЕЧАНИЯ ДЛЯ ПРОДАКШЕНА
# ===========================================
# 1. Измените JWT_SECRET на криптографически стойкий ключ (минимум 32 символа)
#    Команда для генерации: openssl rand -hex 32
#
# 2. Используйте надежные пароли для базы данных и админки
#
# 3. Настройте реальный SMTP сервер:
#    - Установите DEV_MODE=false
#    - Заполните EMAIL_FROM, SMTP_USER, SMTP_PASSWORD
#    - Используйте ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной пароль!)
#
# 4. Установите APP_BASE_URL на ваш реальный домен
#
# 5. Настройте CORS в backend/src/main.py для продакшен домена
CORS в backend/src/main.py для продакшен домена
#
# 6. Разрешены только почтовые сервисы: Yandex, Mail.ru, Gmail
#    Пользователи могут регистрироваться с любой из этих почт,
#    но отправка писем идет с одной почты (EMAIL_FROM)
