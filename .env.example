# ===========================================
# SoftSpeak Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и измените значения по необходимости:
# cp env.template .env

# ------------------- Database -------------------
POSTGRES_USER=softspeak_user
POSTGRES_PASSWORD=softspeak_pass
POSTGRES_DB=softspeak_db
POSTGRES_PORT=5432

# ------------------- Backend API -------------------
BACKEND_PORT=8000
APP_BASE_URL=http://localhost:8000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TTL_MIN=30

# ------------------- Email / SMTP -------------------
EMAIL_FROM=noreply@softspeak.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# MailHog Web Interface
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ------------------- Verification -------------------
VERIFICATION_CODE_TTL_MIN=10
VERIFICATION_CODE_LENGTH=6
RATE_LIMIT_EMAIL_PER_HOUR=5

# ------------------- ML Service -------------------
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://ml-service:8001
ML_MODEL_NAME=intfloat/multilingual-e5-base

# ------------------- Frontend -------------------
FRONTEND_PORT=3000

# ------------------- Matchmaking -------------------
MATCH_SIMILARITY_THRESHOLD=0.65

# ===========================================
# PRODUCTION NOTES:
# ===========================================
# 1. Измените JWT_SECRET на криптографически стойкий ключ (минимум 32 символа)
# 2. Используйте надежные пароли для базы данных
# 3. Настройте реальный SMTP сервер вместо MailHog
# 4. Установите APP_BASE_URL на ваш реальный домен
# 5. Настройте CORS в backend/src/main.py для продакшен домена

